# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRATION=7d

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# AWS S3 (File Uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pos-uploads

# RabbitMQ (Phase 2)
# RABBITMQ_URL=amqp://admin:admin@localhost:5672

# API Gateway
API_GATEWAY_PORT=3000

# Microservices Ports
AUTH_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
PRODUCT_SERVICE_PORT=3004
CUSTOMER_SERVICE_PORT=3005
EMPLOYEE_SERVICE_PORT=3006
INVENTORY_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

// Prisma Schema for POS System
// This is the main database schema file

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN      // Full system access
  MANAGER    // Location management
  SERVER     // Waiter/Waitress
  KITCHEN    // Kitchen staff
  HOST       // Host/Hostess
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed with bcrypt

  firstName String
  lastName  String
  role      UserRole @default(SERVER)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// ORGANIZATIONS & LOCATIONS (Multi-tenant)
// ============================================

model Organization {
  id           String   @id @default(uuid())
  name         String
  type         String   // 'single', 'chain', 'franchise'

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  locations    Location[]

  @@map("organizations")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  code           String?  @unique // Short code like "DT" for Downtown

  addressLine1   String
  city           String
  state          String
  postalCode     String
  country        String   @default("CA")

  timezone       String   @default("America/Toronto")

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("locations")
}

// ============================================
// PRODUCTS & MENU
// ============================================

enum CategoryType {
  FOOD
  BEVERAGE
  ALCOHOL
  MERCHANDISE
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  KOSHER
  KETO
  PALEO
}

enum SpicyLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum DrinkStrength {
  LIGHT      // < 10% ABV
  MEDIUM     // 10-20% ABV
  STRONG     // > 20% ABV
}

model Category {
  id          String       @id @default(uuid())
  name        String
  description String?
  slug        String?      @unique
  type        CategoryType @default(FOOD)

  parentId    String?
  parent      Category?    @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryChildren")

  displayOrder Int         @default(0)
  imageUrl    String?

  isActive    Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products    Product[]

  @@index([parentId])
  @@index([type])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  sku         String?  @unique
  slug        String?  @unique

  basePrice   Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)

  imageUrl    String?

  // Food-specific attributes
  preparationTime Int?      // in minutes
  calories        Int?
  spicyLevel      SpicyLevel @default(NONE)

  // Beverage-specific attributes
  volume          String?   // "16oz", "750ml", etc.
  abv             Float?    // Alcohol by volume percentage
  baseSpirit      String?   // "Vodka", "Gin", "Bourbon", etc.
  drinkStrength   DrinkStrength?

  // Availability
  isAvailable     Boolean  @default(true)
  isActive        Boolean  @default(true)
  availableAllDay Boolean  @default(true)
  availableFrom   DateTime? // Time of day (hour:minute)
  availableTo     DateTime? // Time of day (hour:minute)

  // Relationships
  allergens       ProductAllergen[]
  dietaryTags     ProductDietaryTag[]
  modifiers       ProductModifier[]
  orderItems      OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isAvailable, isActive])
  @@index([slug])
  @@map("products")
}

model Allergen {
  id          String            @id @default(uuid())
  name        String            @unique // "Dairy", "Gluten", "Shellfish", etc.
  description String?
  icon        String?           // Icon name or URL

  products    ProductAllergen[]

  createdAt   DateTime          @default(now())

  @@map("allergens")
}

model ProductAllergen {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([productId, allergenId])
  @@index([productId])
  @@index([allergenId])
  @@map("product_allergens")
}

model ProductDietaryTag {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag        DietaryTag

  createdAt  DateTime    @default(now())

  @@unique([productId, tag])
  @@index([productId])
  @@map("product_dietary_tags")
}

model Modifier {
  id           String            @id @default(uuid())
  name         String            // "Add Grilled Chicken", "Extra Cheese", etc.
  description  String?
  price        Decimal           @db.Decimal(10, 2) @default(0)

  type         String            @default("addon") // "addon", "substitution", "side"

  isActive     Boolean           @default(true)

  products     ProductModifier[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("modifiers")
}

model ProductModifier {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierId String
  modifier   Modifier @relation(fields: [modifierId], references: [id])

  isDefault  Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@unique([productId, modifierId])
  @@index([productId])
  @@index([modifierId])
  @@map("product_modifiers")
}

// ============================================
// TABLES & FLOOR PLAN
// ============================================

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
  OUT_OF_SERVICE
}

model Table {
  id          String      @id @default(uuid())
  locationId  String

  tableNumber String
  displayName String?

  minCapacity Int         @default(1)
  maxCapacity Int

  status      TableStatus @default(AVAILABLE)

  isActive    Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([locationId, tableNumber])
  @@index([locationId, status])
  @@map("tables")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  CURBSIDE
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique

  locationId   String

  orderType    OrderType
  status       OrderStatus @default(PENDING)

  tableId      String?

  subtotal     Decimal     @db.Decimal(10, 2)
  tax          Decimal     @db.Decimal(10, 2)
  tip          Decimal     @db.Decimal(10, 2) @default(0)
  total        Decimal     @db.Decimal(10, 2)

  items        OrderItem[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  completedAt  DateTime?

  @@index([locationId, status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  specialInstructions String?

  modifiers   OrderItemModifier[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  modifierId  String
  name        String    // Snapshot of modifier name at time of order
  price       Decimal   @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ============================================
// PAYMENTS
// ============================================

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String

  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  processorPaymentId String?    // Stripe payment ID

  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ============================================
// CUSTOMER PROFILES
// ============================================

model Customer {
  id            String   @id @default(uuid())

  firstName     String?
  lastName      String?
  email         String?  @unique
  phone         String?  @unique

  loyaltyPoints Int      @default(0)
  totalSpent    Decimal  @db.Decimal(10, 2) @default(0)
  visitCount    Int      @default(0)

  lastVisitAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@map("customers")
}

# Test Environment Configuration
NODE_ENV=test

# Test Database (use a separate test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db_test

# Redis (Test)
REDIS_URL=redis://localhost:6379/1

# JWT Authentication (Test keys)
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=test-refresh-token-secret
REFRESH_TOKEN_EXPIRATION=7d

# Auth Service Port (Test)
AUTH_SERVICE_PORT=3099

# CORS Origins (Test)
CORS_ORIGINS=http://localhost:3099

# Logging
LOG_LEVEL=error
